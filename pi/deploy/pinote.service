# Template only: replace all /absolute/path entries before installing.
[Unit]
Description=Standalone Pinote MCP HTTP service
After=network.target

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/pinote
EnvironmentFile=%h/.config/pinote/service.env
ExecStart=/absolute/path/to/node /absolute/path/to/pinote/pi/dist-mcp/mcp/http.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
