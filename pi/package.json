{
  "name": "pi-note",
  "version": "0.17.1",
  "description": "Persistent pinote tasks, Markdown handoffs, and task status for Pi",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "tasks",
    "notes"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pinote.git",
    "directory": "pi"
  },
  "homepage": "https://github.com/kvidzibo/pinote/tree/main/pi#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pinote/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "footer-status.ts",
    "footer-links.ts",
    "footer-config.ts",
    "footer-settings.ts",
    "task-picker.ts",
    "task-suggestion.ts",
    "setup.ts",
    "preview-bridge.ts",
    "preview-click.cjs",
    "icons",
    "kitty",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:load": "node --test --experimental-strip-types test-load.ts",
    "test": "npm run check && npm run test:unit && npm run test:load"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "22.20.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
