{
  "name": "pi-note",
  "version": "0.54.0",
  "description": "Persistent pinote tasks, Markdown handoffs, and task status for Pi",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "tasks",
    "notes"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pinote.git",
    "directory": "pi"
  },
  "homepage": "https://github.com/kvidzibo/pinote/tree/main/pi#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pinote/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "extension",
    "engine.ts",
    "field-events.ts",
    "notes-version.ts",
    "watcher-host.ts",
    "FIELD_EVENTS.md",
    "watchers",
    "field-watchers.ts",
    "pull-requests.js",
    "pr-batch.js",
    "pr-url.js",
    "forgejo-instances.js",
    "footer-config.ts",
    "config-path.js",
    "task-title.ts",
    "proposal.ts",
    "icons",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:load": "node --test --experimental-strip-types test-load.ts",
    "test": "npm run check && npm run test:unit && npm run test:load"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "22.20.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "*",
    "zod": "^4.6.7"
  }
}
