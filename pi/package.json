{
  "name": "pi-note",
  "version": "0.33.4",
  "description": "Persistent pinote tasks, Markdown handoffs, and task status for Pi",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "tasks",
    "notes"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pinote.git",
    "directory": "pi"
  },
  "homepage": "https://github.com/kvidzibo/pinote/tree/main/pi#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pinote/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "remote.ts",
    "remote",
    "LOCAL.md",
    "deploy",
    "footer-status.ts",
    "footer-links.ts",
    "footer-config.ts",
    "config-path.ts",
    "token.ts",
    "mcp",
    "dist-mcp",
    "footer-settings.ts",
    "task-picker.ts",
    "task-suggestion.ts",
    "setup.ts",
    "preview-bridge.ts",
    "preview-click.cjs",
    "icons",
    "kitty",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./remote.ts"
    ]
  },
  "scripts": {
    "build:mcp": "tsc -p tsconfig.mcp.json && node -e \"require('node:fs').cpSync('icons', 'dist-mcp/icons', { recursive: true })\"",
    "prepack": "npm run build:mcp",
    "mcp": "node dist-mcp/mcp/server.js",
    "serve": "node dist-mcp/mcp/http.js",
    "check": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:load": "node --test --experimental-strip-types test-load.ts test-remote-load.ts",
    "test": "npm run build:mcp && npm run check && npm run test:unit && npm run test:load"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.20.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
